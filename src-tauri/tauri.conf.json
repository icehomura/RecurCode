{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RecurCode",
  "version": "0.35.1",
  "identifier": "app.rc",
  "build": {
    "beforeDevCommand": "pnpm tauri:before-dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm tauri:before-build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../out": "web/"
    },
    "externalBin": [
      "binaries/rc-mcp",
      "binaries/rc-computer-helper",
      "binaries/ra",
      "binaries/ra-sandbox",
      "binaries/news_fetch",
      "binaries/deep-search",
      "binaries/deep_crawl",
      "binaries/send_email",
      "binaries/account_manager",
      "binaries/voice",
      "binaries/clock",
      "binaries/weather",
      "binaries/smart_home",
      "binaries/rb"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "./linux/main.desktop"
      },
      "rpm": {
        "desktopTemplate": "./linux/main.desktop"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["rc"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4OEM3NkMyMTVENjdBODgKUldTSWV0WVZ3bmFNU0NnSzhpdFg2bXFmMHFidWd1eWpuZ2Y2WmU5QmVXdWVrU0ZpOCt2dnd6WW4K",
      "endpoints": [
        "https://github.com/spacering-net/codeg/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
